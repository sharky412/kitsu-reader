<?xml version="1.0" encoding="utf-8"?>
<!--
	The rounded press state for list items. The ripple colour matches list_selector so that every
	item in a list reacts identically to a touch, whichever layout it happens to use.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
	android:color="@color/selector_overlay">
	<item
		android:id="@android:id/mask">
		<shape android:shape="rectangle">
			<corners android:radius="@dimen/list_selector_corner" />
			<solid android:color="@color/selector_overlay" />
		</shape>
	</item>
</ripple>
